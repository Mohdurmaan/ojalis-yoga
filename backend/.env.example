# Server Port (Hosting providers like Render/Railway automatically assign PORT)
PORT=5000

# MongoDB Connection URI (Use MongoDB Atlas SRV URI in production)
# Local: mongodb://127.0.0.1:27017/ojalisyoga
# Atlas: mongodb+srv://<username>:<password>@cluster0.p28iyse.mongodb.net/ojalisyoga?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/ojalisyoga

# JWT Secret for Admin Authentication
JWT_SECRET=your_jwt_secret_here

# Allowed Frontend URL(s) for CORS (Comma-separated if multiple domains)
# Example: https://ojalis-yoga.pages.dev,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cloudinary Persistent Image Storage (Recommended for Render ephemeral containers)
# Create a free account at https://cloudinary.com and get credentials from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternative single connection URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Razorpay Integration (Optional: required for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
